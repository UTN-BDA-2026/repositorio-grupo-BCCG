
from PySide6.QtUiTools import QUiLoader
import os

class Ventas():
    def __init__(self, usuario):
        loader = QUiLoader()
        ruta = os.path.join(
            os.path.dirname(__file__),
            "ventas.ui"
        )

        self.ventana = loader.load(ruta)
        self.usuario = usuario
        self.initGUI()
        self.ventana.show()

    def initGUI(self):
        self.ventana.btnVolver.clicked.connect(
            self.volver
        )

    def volver(self):
        from gui.admin import Admin
        self.admin = Admin(self.usuario)
        self.ventana.close()
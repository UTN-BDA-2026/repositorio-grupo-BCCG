  <property name="styleSheet">
   <string notr="true">QDialog#Dialog {
    background-color: #FFFFFF;
}

QLabel#label {
    color: #2C3E50;
    font-size: 18px;
    font-weight: bold;
    letter-spacing: 1px;
    margin-bottom: 10px;
}

/* Estilo para las etiquetas de texto (Nombre, Usuario, etc.) */
QLabel {
    color: #4A5568;
    font-size: 13px;
    font-weight: bold;
}

/* Campos de Texto e Inputs */
QLineEdit, QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 13px;
    color: #334155;
}


QLineEdit:focus, QComboBox:focus {
    border: 2px solid #D1A19A; 
}

/* La Tabla de Usuarios */
QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    gridline-color: #F1F5F9;
    font-size: 13px;
}

QHeaderView::section {
    background-color: #334155; /* Cabecera oscura para contraste pro */
    color: #FFFFFF;
    padding: 6px;
    font-weight: bold;
    border: none;
}

/* --- ESTILOS DE LOS BOTONES --- */

/* Botón Crear (Naranja Corporativo) */
QPushButton#btn_registrar {
    background-color: #FF9100;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    font-weight: bold;
    font-size: 13px;
}
QPushButton#btn_registrar:hover {
    background-color: #FB8C00;
}

/* Botón Eliminar (Gris/Rojo sutil de advertencia) */
QPushButton#btn_eliminar {
    background-color: #FEE2E2; /* Fondo rojo muy clarito */
    color: #EF4444; /* Texto rojo */
    border: 1px solid #FCA5A5;
    border-radius: 6px;
    font-weight: bold;
    font-size: 13px;
}
QPushButton#btn_eliminar:hover {
    background-color: #EF4444;
    color: #FFFFFF;
}

/* Botón Volver (Estilo elegante y neutro) */
QPushButton#btn_volver {
    background-color: #64748B; /* Gris slate */
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    font-weight: bold;
    font-size: 13px;
}
QPushButton#btn_volver:hover {
    background-color: #475569;
}
QSpinBox {
    background-color: white;
    color: #333333;
    border: 2px solid #C59B9B; 
    border-radius: 10px;
    padding-left: 5px;
    padding-right: 22px; 
    min-height: 25px;
}

/* Contenedor de los botones (les damos un fondo gris claro para que Qt dibuje las flechas) */
QSpinBox::up-button, QSpinBox::down-button {
    background-color: #F0F0F0;
    width: 18px;
    border: none;
}

/* Botón de arriba: redondeamos solo la esquina superior derecha */
QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    border-top-right-radius: 8px;
    margin-top: 2px;
    margin-right: 2px;
    margin-bottom: 0px;
}

/* Botón de abajo: redondeamos solo la esquina inferior derecha */
QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    border-bottom-right-radius: 8px;
    margin-bottom: 2px;
    margin-right: 2px;
    margin-top: 0px;
}

/* Efecto visual cuando pasás el mouse por encima de las flechas */
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #E0E0E0;
}</string>

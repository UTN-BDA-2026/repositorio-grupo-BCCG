   <property name="styleSheet">
    <string notr="true">QPushButton {
    background-color: #ff914c; /* El naranja exacto de tu botón &quot;Crear Usuario&quot; */
    color: white;
    font-family: 'Segoe UI', sans-serif;
    font-size: 13px;
    font-weight: bold;
    border: none;
    border-radius: 6px; /* Para que quede bien redondeado como el otro */
    padding: 6px 15px;
}

QPushButton:hover {
    background-color: #e67e3a; /* Se oscurece un poquito cuando pasás el mouse */
}

QPushButton:pressed {
    background-color: #cc6d30; /* Se oscurece más cuando lo apretás */
}
</string>

  <property name="styleSheet">
   <string notr="true">QWidget#FormStock {
    background-color: #FFFFFF; /* Blanco puro, impecable y brillante */
}

/* Título de la ventana (Color violeta oscuro/berenjena para combinar) */
QLabel#label {
    color: #3B2A4A; 
    font-size: 18px;
    font-weight: bold;
    letter-spacing: 1px;
    margin-bottom: 10px;
}

/* Estilo para las etiquetas de texto (Nombre, Usuario, etc.) */
QLabel {
    color: #4A5568;
    font-size: 13px;
    font-weight: bold;
}

/* Campos de Texto e Inputs */
QLineEdit, QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 13px;
    color: #334155;
}


QLineEdit:focus, QComboBox:focus {
    border: 2px solid #D1A19A; 
}

QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    gridline-color: #E2E8F0; /* Líneas divisorias más finitas y delicadas */
    font-size: 13px;
    
    /* NUEVO: Selección de celdas a tono con los botones rosa */
    selection-background-color: #D1A19A;
    selection-color: white;
}


QHeaderView::section {
    background-color: #3B2A4A; 
    color: #FFFFFF;
    padding: 6px;
    font-weight: bold;
    border: none;
}


QPushButton#btn_registrar {
    background-color: #D1A19A;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    font-weight: bold;
    font-size: 13px;
    border: 1px solid #B88680;
}
QPushButton#btn_registrar:hover {
    background-color: #C29089;
}
QPushButton#btn_registrar:pressed {
    background-color: #B3817A;
}

